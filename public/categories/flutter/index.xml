</span></span><span class="line"><span class="cl">  <span class="nl">child:</span> <span class="n">Padding</span><span class="p">(</span>
</span></span><span class="line"><span class="cl">      <span class="nl">padding:</span> <span class="kd">const</span> <span class="n">EdgeInsets</span><span class="p">.</span><span class="n">symmetric</span><span class="p">(</span><span class="nl">horizontal:</span> <span class="m">40</span><span class="p">),</span>
</span></span><span class="line"><span class="cl">      <span class="nl">child:</span> <span class="n">Column</span><span class="p">(</span></span></span></code></pre></div></div>
